{
  "name": "ha-scene-card",
  "version": "1.2.1",
  "description": "Lovelace cards for Home Assistant to launch scenes and scripts: a grid of scenes with the active one highlighted, scripts with their running state.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node --check dist/scene-card.js",
    "test": "node --test test/*.test.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "acorn": "^8.19.0",
    "css-tree": "^3.2.1",
    "playwright": "^1.56.1"
  }
}
